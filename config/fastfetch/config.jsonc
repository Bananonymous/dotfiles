{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "endeavouros",
        "padding": {
            "top": 2,
            "right": 2
        }
    },
    "display": {
        "separator": ""
    },
    "modules": [
        {
            "type": "custom",
            "format": "{#90}╭──── {#35}System{#90} ──────────────────────────────────────────────╮"
        },
        { "type": "os",       "key": "  {#36}󰣇 {#90}─ " },
        { "type": "kernel",   "key": "  {#34}󰒋 {#90}─ " },
        { "type": "uptime",   "key": "  {#32}󰅐 {#90}─ " },
        { "type": "packages", "key": "  {#33}󰏗 {#90}─ " },
        { "type": "shell",    "key": "  {#35}󱆃 {#90}─ ", "format": "{pretty-name} {version}" },
        {
            "type": "custom",
            "format": "{#90}╰──────────────────────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "custom",
            "format": "{#90}╭──── {#35}Desktop{#90} ─────────────────────────────────────────────╮"
        },
        { "type": "wm",       "key": "  {#36}󰖮 {#90}─ ", "format": "{pretty-name} {version}" },
        { "type": "terminal", "key": "  {#34}󰅭 {#90}─ ", "format": "{pretty-name} {version}" },
        {
            "type": "custom",
            "format": "{#90}╰──────────────────────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "custom",
            "format": "{#90}╭──── {#35}Hardware{#90} ────────────────────────────────────────────╮"
        },
        { "type": "display",  "key": "  {#34}󰍹 {#90}─ ", "format": "{width}x{height} @ {refresh-rate}Hz" },
        {
            "type": "cpu",
            "key": "  {#32}󰻠 {#90}─ ",
            "showPeCoreCount": true,
            "format": "{name} ({cores-physical}c/{cores-logical}t) @ {freq-max}"
        },
        {
            "type": "gpu",
            "key": "  {#33}󰾲 {#90}─ ",
            "detectionMethod": "pci",
            "hideType": "integrated",
            "format": "{name}"
        },
        { "type": "memory",  "key": "  {#35}󰍛 {#90}─ ", "format": "{used} / {total} ({percentage})" },
        {
            "type": "disk",
            "key": "  {#36}󰋊 {#90}─ ",
            "folders": "/",
            "format": "/ {size-used} / {size-total} ({size-percentage})"
        },
        { "type": "localip",  "key": "  {#32}󰩟 {#90}─ ", "showIpv4": true, "showIpv6": false, "format": "{ipv4} ({ifname})" },
        {
            "type": "custom",
            "format": "{#90}╰──────────────────────────────────────────────────────────╯"
        },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 1 }
    ]
}
